#! /usr/bin/env sh
# workbench [-n|--dry-run] [DIR]
# Open a Rex session named after DIR (default: $PWD) with one Editor tab, rooted at DIR. The left side holds $EDITOR, or
# nvim when it is unset. The right side attaches to a tmux session of the same name, with Claude, Codex, and CLI windows.
# Everything lives in the one Rex session, so no other app opens. A Rex session with that name is reused, not
# duplicated. The tmux session outlives the Rex session, so a new Rex session attaches to it again.
# A bare DIR such as `harness-kit` names a folder under $WORKBENCH_HOME when one exists there. A path that starts with
# `/`, `./`, or `../`, or is `.` or `..`, always means that path.

dry_run=
if [ "$1" = "-n" ] || [ "$1" = "--dry-run" ]; then
  dry_run=1
  shift
fi

requested=${1:-$PWD}
case "$requested" in
  /* | . | .. | ./* | ../*) ;;
  *) [ -n "$WORKBENCH_HOME" ] && [ -d "${WORKBENCH_HOME%/}/$requested" ] && requested=${WORKBENCH_HOME%/}/$requested ;;
esac

cwd=$(cd "$requested" 2>/dev/null && pwd -P) || {
  echo "workbench: no such directory: $requested" >&2
  [ -n "$WORKBENCH_HOME" ] && echo "workbench: also looked in $WORKBENCH_HOME" >&2
  exit 1
}
project=${cwd##*/}

for tool in rex jq tmux; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "workbench: $tool not found on PATH" >&2
    exit 1
  }
done

# Percent of the window width given to the agents.
agents_percent=35
editor_command=${EDITOR:-nvim}
user_shell=${SHELL:-zsh}

# tmux changes `.` and `:` in a session name to `_`, and `=` makes a target match the whole name.
tmux_name=$(printf '%s' "$project" | tr '.:' '__')
tmux_target="=$tmux_name"

show_session() {
  rex do session.select session_id="$session" >/dev/null 2>&1 ||
    echo "workbench: session \"$project\" is ready. Select it in Rex, or enable Remote Control to select it from here." >&2
}

# Run agents under a non-interactive login shell (PATH, no prompt or banner), then fall back to a normal login shell.
# tmux panes inherit the environment of whoever started the tmux server, so give the session the Rex IDs of this
# workbench. Agents read REX_SESSION and REX_EDITOR_BLOCK to find the editor. An existing tmux session keeps its old
# windows, which hold old IDs, but new windows get the current ones.
create_tmux_session() {
  if tmux has-session -t "$tmux_target" 2>/dev/null; then
    tmux set-environment -t "$tmux_target" REX_SESSION "$session" &&
      tmux set-environment -t "$tmux_target" REX_EDITOR_BLOCK "$editor"
    return
  fi
  PROJECT=$project tmux new-session -d -s "$tmux_name" -n Claude -c "$cwd" \
    -e "REX_SESSION=$session" -e "REX_EDITOR_BLOCK=$editor" \
    "$user_shell -lc 'landline claude --project \"\$PROJECT\"; exec $user_shell -l'" \; \
    new-window -n Codex -c "$cwd" "$user_shell -lc 'codex; exec $user_shell -l'" \; \
    new-window -n CLI -c "$cwd" \; \
    select-window -t Claude
}

if [ -n "$dry_run" ]; then
  cat <<DRYRUN
cwd: $cwd
rex new "$project" -c "$cwd" --window Editor --json -- sh -c "exec $editor_command"
tmux new-session -d -s "$tmux_name" -n Claude -c "$cwd" -e REX_SESSION=SESSION -e REX_EDITOR_BLOCK=EDITOR ...   (then windows Codex and CLI), unless it exists
rex split -s SESSION -b EDITOR --split=right --ratio $agents_percent --label Agents -c "$cwd" -- tmux attach -t "$tmux_target"
rex do session.select session_id=SESSION
DRYRUN
  exit 0
fi

session=$(rex ls --json | jq -r --arg label "$project" '[.sessions[] | select(.label == $label)][0].session_id // empty')
if [ -n "$session" ]; then
  show_session
  exit 0
fi

created=$(rex new "$project" -c "$cwd" --window Editor --json -- sh -c "exec $editor_command") &&
  session=$(printf '%s' "$created" | jq -er '.session_id') &&
  editor=$(printf '%s' "$created" | jq -er '.initial_windows[0].block_ids[0]') || {
  echo "workbench: could not create session \"$project\"" >&2
  exit 1
}

create_tmux_session || {
  echo "workbench: could not create tmux session \"$tmux_name\"" >&2
  exit 1
}

rex split -s "$session" -b "$editor" --split=right --ratio "$agents_percent" --label Agents -c "$cwd" --json \
  -- tmux attach -t "$tmux_target" >/dev/null
show_session
